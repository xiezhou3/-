DATABASE_URL=postgres://agilecampus:agilecampus_dev@localhost:5432/agilecampus
AUTH_SECRET=change-me-run-npx-auth-secret
# 本机一键启动或反向代理部署时设为 true，避免 Auth.js 拒绝非 localhost Host。
AUTH_TRUST_HOST=true
# 对外访问地址（飞书 OAuth 回调据此拼接跳转，生产须设真实域名）。
AGILECAMPUS_URL=http://localhost:3000
# 本地文件存储（开发环境默认使用项目目录下的 storage）。
FILE_STORAGE_ROOT=./storage
STORAGE_DRIVER=local
MAX_FILE_SIZE_BYTES=2147483648
# LibreOffice 可执行文件；Linux 默认 /usr/bin/soffice，Windows 留空时自动查找默认安装目录。
LIBREOFFICE_PATH=
# 可选：服务端兜底密钥。留空也行——成员可在「项目助手 → AI 设置」里各自填 Key（加密存库）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型番号：缺省 deepseek-v4-flash（迅捷省耗）；重推理可换 deepseek-v4-pro。
# 注意：旧番号 deepseek-chat 已被 DeepSeek 废弃，填之必返 400。
DEEPSEEK_MODEL=deepseek-v4-flash

# GitHub 仓库连接与读写。公开仓库可留空；私有仓库和更高 API 配额需填写。
GITHUB_TOKEN=

# 生产 compose（docker-compose.prod.yml）数据库密码，变量插值单一来源，勿留空。
POSTGRES_PASSWORD=change-me-strong-password

# 飞书自建应用（Lark），用于绑定成员和消息提醒。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
FEISHU_BASE_URL=https://open.feishu.cn
# 定时提醒 cron 端点保护密钥（自定义高熵串，如 openssl rand -hex 32）。
CRON_SECRET=
